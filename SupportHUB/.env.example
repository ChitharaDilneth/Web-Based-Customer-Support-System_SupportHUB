# SupportHUB Enterprise Platform Environment Configuration
# Copy this file to .env or supply through container environment / CI secrets manager.

# Server Configuration
SERVER_PORT=8080
API_BASE_PATH=/api

# Database Configuration (MySQL - Least-Privilege Account)
# Run the following SQL in MySQL to create the least-privilege service account:
#   CREATE USER 'supporthub_app'@'localhost' IDENTIFIED BY 'YourStrongPassword#2026';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, INDEX ON customer_support_db.* TO 'supporthub_app'@'localhost';
#   FLUSH PRIVILEGES;
DB_URL=jdbc:mysql://localhost:3306/customer_support_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=supporthub_app
DB_PASSWORD=YourStrongPassword#2026

# JWT Security Configuration (MANDATORY IN PRODUCTION)
# Generate a 256-bit cryptographically secure secret (e.g. via openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_high_entropy_256bit_hex_secret
JWT_EXPIRATION_MS=86400000

# Supervisor Initial Credential Provisioning
# In production, specify the initial bootstrap password here. It will NOT be printed to logs.
SUPERVISOR_INITIAL_PASSWORD=YourSecureSupervisorBootstrapPassword#2026

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080
