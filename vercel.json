{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "SupportHUB/frontend",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/unauthorized", "destination": "/unauthorized.html" },
    { "source": "/knowledge-base", "destination": "/knowledge-base.html" }
  ]
}
